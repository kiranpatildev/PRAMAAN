# Copy to .env for local dev:  copy .env.example .env  (Windows) / cp .env.example .env
SECRET_KEY=dev-insecure-change-me
DEBUG=1
NEO4J_PASSWORD=pramaan-neo4j
MINIO_ACCESS_KEY=pramaan
MINIO_SECRET_KEY=pramaan123
GEMINI_API_KEY=
# Generation model override. Default gemini-2.5-flash; the backend walks a
# fallback chain (1.5-flash → 3.6/3.5/3.8-flash) on retired-model 404s, so a
# sunset degrades instead of outageing the copilot.
# GEMINI_MODEL=gemini-2.5-flash
SENTRY_DSN=
# At-rest encryption for User.phone + totp_secret (Fernet, base64).
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Empty = passthrough (dev only); set a real key in hosted envs.
FIELD_ENCRYPTION_KEY=
# Base URL of the (mock) external ICJS case-bundle API. Inside compose the
# backend reaches it as http://mock-icjs:9090; override only for host-side dev
# against a locally-run mock (if you publish its port yourself).
ICJS_MOCK_BASE_URL=http://mock-icjs:9090
