# Copy to .env for local dev:  copy .env.example .env  (Windows) / cp .env.example .env
SECRET_KEY=dev-insecure-change-me
DEBUG=1
NEO4J_PASSWORD=pramaan-neo4j
MINIO_ACCESS_KEY=pramaan
MINIO_SECRET_KEY=pramaan123
GEMINI_API_KEY=
SENTRY_DSN=
# Base URL of the (mock) external ICJS case-bundle API. Inside compose the
# backend reaches it as http://mock-icjs:9090; override only for host-side dev
# against a locally-run mock (if you publish its port yourself).
ICJS_MOCK_BASE_URL=http://mock-icjs:9090
